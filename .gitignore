# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
logs/

# 项目级本地工具（lark-cli 等，不入库：卸载 = 删目录）
.tools/

# claude code & codex
.codex
.claude
*.md
!README.md

# 环境变量
.env
.env.*
!.env.example

# 飞书验证测试产物（含真实 UAT / refresh_token，绝不入库）
.lark_uat_token*.json

# 飞书绑定域本地库（LARK_DATABASE_URL 的 SQLite 落点；内含**加密后**的 UAT，仍不入库）
.lark.db
.lark.db-journal
.lark.db-wal
.lark.db-shm

# 本地测试临时目录（受限沙箱下 pytest basetemp 的落点）
.testtmp/

/scripts
/tests
