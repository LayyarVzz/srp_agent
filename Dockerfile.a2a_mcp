# a2a_mcp 独立运行镜像（把远端智能体封装为 MCP 工具）
#
# 与 Dockerfile.tools_mcp 同构：服务自包含（只依赖本包 + config），
# 不 import agent 包、不读项目根 settings.py，可独立打包部署。
#
# 构建：
#   docker build -f Dockerfile.a2a_mcp -t srp-agent-a2a-mcp:latest .
#
# 注册表门控（零回归）：env `A2A_MCP_AGENTS`（JSON {"<agent_id>": "<base_url>"}）
# 为空时，服务照常在端口上跑、但 Agent 侧不登记该服务（settings.a2a_mcp_agents 空
# → runtime 门控跳过），工具集与既有完全一致（见 services/a2a_mcp/README.md）。
#
# 瘦身要点（plan-docker-observability.md §3）：构建期/运行期分离 + cache mount + 裁剪。

# ---------- 构建期：只负责产出 /app/.venv ----------
FROM python:3.12-slim AS builder

# uv 钉版本（`:latest` 不可复现）；libc 变体须与基底一致（Debian/glibc）。
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/root/.cache/uv

WORKDIR /app

# --no-install-project：只装依赖、不装本项目包（运行靠源码目录，见 CMD）。
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=README.md,target=README.md \
    uv sync --frozen --no-dev --no-install-project

# ---------- 运行期：干净基底 + 只搬 .venv 与源码 ----------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

# 只复制本服务及其包结构（services/__init__.py 提供 services 命名空间包）
COPY services/__init__.py ./services/__init__.py
COPY services/a2a_mcp ./services/a2a_mcp

# streamable-http 默认端口；host/port/path 由 compose 的 MCP_* 环境变量覆盖
EXPOSE 8102

CMD [".venv/bin/python", "-m", "services.a2a_mcp"]