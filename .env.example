# —— 项目运行环境配置示例（复制为 .env 后按需修改）——
# 值来源优先级：进程环境变量 > .env 文件 > 代码默认值。
# 说明：Agent 框架**行为**参数（LLM 温度/超时/重试、工具迭代上限、记忆 top_k 等）
#       在 agent/core/config.py 中以代码默认值配置，不在此处。

# —— 运行环境 ——
ENVIRONMENT=dev                  # dev | test | prod
# API_HOST=0.0.0.0
# API_PORT=8000

# —— LLM 运行选择 + 密钥（DeepSeek / Qwen / 任意 OpenAI 兼容端点）——
LLM_PROVIDER=deepseek            # deepseek | qwen | openai_compatible
LLM_API_KEY=                     # 必填；DeepSeek 在 platform.deepseek.com 申请
# LLM_BASE_URL=                  # 覆盖预设；DeepSeek: https://api.deepseek.com/v1
# LLM_MODEL=                     # 覆盖预设；DeepSeek 默认 deepseek-v4-flash
                                 #  Qwen 预设: https://{workspace_id}.aliyuncs.com/compatible-mode/v1 

# —— tools_mcp 服务（stdio 默认；配 MCP_TRANSPORT=streamable-http 即以 HTTP 运行）——
# MCP_TRANSPORT=stdio                 # stdio | streamable-http（注意连字符）
# MCP_HOST=127.0.0.1                  # 云服务器/外部访问需 0.0.0.0
# MCP_PORT=8100                       # 避开 API_PORT=8000
# MCP_STREAMABLE_HTTP_PATH=/mcp
# MCP_STATELESS_HTTP=true             # 工具纯函数无会话，开启支持水平扩展

# —— 外部 MCP 服务地址——
# RAG_MCP_URL=
# MEMORY_MCP_URL=
# QDRANT_URL=

# —— 讯飞语音听写（IAT）——
# XF_IAT_APP_ID=
# XF_IAT_API_KEY=
# XF_IAT_API_SECRET=

# —— embedding（与 RAG 对齐；语义召回开关）——
EMBEDDING_ENABLED=false            # 置 true 启用语义召回/去重
EMBEDDING_MODEL=                   # 与 RAG 同一模型名
# 千问示例：EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMS=0                   # 与模型一致；千问 qwen3.7-text-embedding 常用 1024
# EMBEDDING_BASE_URL=              # OpenAI 兼容端点；缺省用官方 OpenAI
#                                  千问: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=               # 千问用 DASHSCOPE_API_KEY

# —— Postgres 记忆后端（生产持久化；缺省则不启用，回退 InMemoryStore + MemorySaver）——
# checkpointer（会话/短期）与 Store（长期/会话元数据）共用此库。需先 docker 起 postgres：
# 语义召回需 pgvector 扩展，镜像须用 pgvector/pgvector:pg17（postgres:latest 不含 vector）：
#   docker run -d --name srp-agent-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=srp_agent -p 5432:5432 -v srp_pgdata:/var/lib/postgresql \
#     pgvector/pgvector:pg17
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srp_agent

# —— 日志 ——
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
