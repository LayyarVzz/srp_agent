# —— 项目运行环境配置示例（复制为 .env 后按需修改）——
# 值来源优先级：进程环境变量 > .env 文件 > 代码默认值。
# 说明：Agent 框架**行为**参数（LLM 温度/超时/重试、工具迭代上限、记忆 top_k 等）
#       在 agent/core/config.py 中以代码默认值配置，不在此处。

# —— 运行环境 ——
ENVIRONMENT=dev                  # dev | test | prod
# API_HOST=0.0.0.0
# API_PORT=8000

# —— LLM 运行选择 + 密钥（DeepSeek / Qwen / 任意 OpenAI 兼容端点）——
LLM_PROVIDER=deepseek            # deepseek | qwen | openai_compatible
LLM_API_KEY=                     # 必填；DeepSeek 在 platform.deepseek.com 申请
# LLM_BASE_URL=                  # 覆盖预设；DeepSeek: https://api.deepseek.com/v1
# LLM_MODEL=                     # 覆盖预设；DeepSeek 默认 deepseek-v4-flash
                                 #  Qwen 预设: https://{workspace_id}.aliyuncs.com/compatible-mode/v1 

# —— tools_mcp 服务（stdio 默认；配 MCP_TRANSPORT=streamable-http 即以 HTTP 运行）——
# MCP_TRANSPORT=stdio                 # stdio | streamable-http（注意连字符）
# MCP_HOST=127.0.0.1                  # 云服务器/外部访问需 0.0.0.0
# MCP_PORT=8100                       # 避开 API_PORT=8000
# MCP_STREAMABLE_HTTP_PATH=/mcp
# MCP_STATELESS_HTTP=true             # 工具纯函数无会话，开启支持水平扩展

# —— A2A 智能体互联（T5 Server 入站 + T6 Client 出站，见 TESTING.md §5.10）——
# A2A_ENABLED=true                    # 入站总开关；关闭时方法调用拒绝（AgentCard 发现不受影响）
# A2A_PEER_MAP=                       # 入站 peer 注册表：JSON {"<peer_id>": "<user_id>"}
#                                     # 未登记 peer 拒绝；user_id 空 → 匿名命名空间 a2a:<peer_id>
# A2A_MCP_ENABLED=true                # T6 a2a_mcp 服务总开关（与注册表非空同时满足才登记）
# A2A_MCP_AGENTS=                     # T6 远端注册表：JSON {"<agent_id>": "<base_url>"}，空表零回归
# A2A_MCP_PEER_ID=srp-agent           # 调用远端时声明的 peer 身份（远端须已登记该 peer）
# A2A_MCP_HOST=127.0.0.1              # streamable-http 形态的 a2a_mcp 地址（容器部署 = 服务名）
# A2A_MCP_PORT=8102                   # 避开 API 8000 / tools_mcp 8100 / lark_mcp 8101

# —— 外部 MCP 服务地址——
# RAG_MCP_URL=
# MEMORY_MCP_URL=
# QDRANT_URL=

# —— 讯飞语音听写（IAT）：语音链路配置统一由 settings.py 管理 ——
# 未配置时语音接口返回 asr.missing_credentials（500），文本交互不受影响；
# 前端可用 transcript 字段直传文本完成降级联调（见 api.md §4.4）。
# XF_IAT_APP_ID=
# XF_IAT_API_KEY=
# XF_IAT_API_SECRET=
# XF_IAT_URL=wss://iat-api.xfyun.cn/v2/iat   # 可覆盖默认端点

# —— 飞书 lark-cli（T4）：项目级安装与一次性鉴权见 services/lark_mcp/README.md ——
# 探测失败/禁用时 lark_mcp 不登记，Agent 以既有工具集照常服务（零回归）。
# LARK_CLI_ENABLED=true
# LARK_CLI_COMMAND=.tools/lark/node_modules/@larksuite/cli/bin/lark-cli.exe

# —— 飞书账号绑定（v5.1）：**每个 Agent 用户绑定各自的飞书账号、互不可见** ——
# 应用仅作 OAuth 客户端（无 bot 身份）；工具调用恒 --as user，身份来自各自绑定的 UAT。
# 绑定闭环在对话内完成：用户说「帮我绑定飞书」→ 扫码授权 → 「我已完成授权」→ 落库加密。
# LARK_APP_ID=                      # 飞书开放平台应用（设备码授权用）
# LARK_APP_SECRET=
# LARK_TOKEN_KEY=                   # 令牌加密密钥（Fernet 派生源）—— 必配！
#                                    生成：python -c "import secrets;print(secrets.token_hex(32))"
#                                    未配置 → 绑定功能 fail-closed 关闭，绝不落明文 token
# LARK_BINDING_ENABLED=true         # 绑定总开关（密钥缺失时仍自动关闭）
# LARK_CLI_TIMEOUT_S=30
# LARK_OUTPUT_MAX_CHARS=10000
# LARK_ACCOUNTS_BASE_URL=https://accounts.feishu.cn   # 认证族域名（Lark 版改 larksuite.com）
# LARK_OPEN_BASE_URL=https://open.feishu.cn           # 业务族域名（Lark 版改 larksuite.com）
# LARK_TOKEN_REFRESH_SKEW_S=300     # 提前刷新窗口（秒）
# LARK_OAUTH_TIMEOUT_S=15
# LARK_DEVICE_FLOW_POLL_MAX_S=600

# 配置态单用户模式（零回归路径）：不配 LARK_TOKEN_KEY 时的本地/单机形态。
# 此时**多用户隔离不可用**（一份共享凭据），仅用于 demo 与单机验证。
# LARK_USER_ACCESS_TOKEN=

# —— embedding（与 RAG 对齐；语义召回开关）——
EMBEDDING_ENABLED=false            # 置 true 启用语义召回/去重
EMBEDDING_MODEL=                   # 与 RAG 同一模型名
# 千问示例：EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMS=0                   # 与模型一致；千问 qwen3.7-text-embedding 常用 1024
# EMBEDDING_BASE_URL=              # OpenAI 兼容端点；缺省用官方 OpenAI
#                                  千问: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=               # 千问用 DASHSCOPE_API_KEY

# —— Postgres 记忆后端（生产持久化；缺省则不启用，回退 InMemoryStore + MemorySaver）——
# checkpointer（会话/短期）与 Store（长期/会话元数据）共用此库。需先 docker 起 postgres：
# 语义召回需 pgvector 扩展，镜像须用 pgvector/pgvector:pg17（postgres:latest 不含 vector）：
#   docker run -d --name srp-agent-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=srp_agent -p 5432:5432 -v srp_pgdata:/var/lib/postgresql \
#     pgvector/pgvector:pg17
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srp_agent

# —— 日志 ——
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
